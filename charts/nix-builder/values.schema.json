{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "ssh": {
      "type": "object",
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "authorizedKeys": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        }
      }
    },
    "scaleToZero": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "idleSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "startupTimeoutSeconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "tcpRoute": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "parentRefs": {
          "type": "array"
        }
      },
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        },
        "required": [
          "enabled"
        ]
      },
      "then": {
        "properties": {
          "parentRefs": {
            "minItems": 1
          }
        }
      }
    },
    "attic": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "endpoint": {
          "type": "string"
        },
        "cache": {
          "type": "string"
        },
        "configureNix": {
          "type": "boolean"
        },
        "jobs": {
          "type": "integer",
          "minimum": 1
        },
        "retrySeconds": {
          "type": "integer",
          "minimum": 1
        },
        "drainTimeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "auth": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "secretKey": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "catchUpIntervalSeconds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        },
        "required": [
          "enabled"
        ]
      },
      "then": {
        "properties": {
          "endpoint": {
            "minLength": 1,
            "pattern": "^https?://[^\\s]+$"
          },
          "cache": {
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
          },
          "auth": {
            "properties": {
              "existingSecret": {
                "minLength": 1
              }
            },
            "required": [
              "existingSecret"
            ]
          }
        },
        "required": [
          "endpoint",
          "cache",
          "auth"
        ]
      }
    }
  }
}
